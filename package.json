{
  "name": "@jankrajewskiit/demo",
  "version": "3.7.10",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetdemo.git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --force",
    "build": "tsc -b && vite build && npm run performance:report && npm run build:spa",
    "performance:report": "configs-bundle-report",
    "preview": "vite preview",
    "verify": "npm run toolchain && npm run editor:check && npm run format:check && npm run lint && npm run quality:check && npm run lint:css && npm run build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix --max-warnings 0",
    "prepare": "husky",
    "toolchain": "configs-toolchain",
    "audit:deps": "configs-audit",
    "prebuild": "npm run toolchain",
    "build:spa": "configs-spa",
    "verify:container": "node .deployment/spa/verify-spa.mjs velvet-spa:verified",
    "editor:sync": "configs-editor --write",
    "editor:check": "configs-editor",
    "predev": "npm run toolchain",
    "prepreview": "npm run toolchain",
    "deps:check": "knip --no-exit-code --reporter json",
    "deps:strict": "configs-unused",
    "architecture:check": "configs-architecture",
    "duplicates:report": "configs-duplicates",
    "quality:check": "npm run architecture:check && npm run duplicates:report && npm run deps:strict"
  },
  "dependencies": {
    "@jankrajewskiit/auth": "^3.7.10",
    "@jankrajewskiit/data": "^3.7.10",
    "@jankrajewskiit/i18n": "^3.7.10",
    "@jankrajewskiit/ui": "^3.7.10",
    "lightweight-charts": "^5.2.1",
    "oidc-client-ts": "^3.5.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "web-vitals": "^6.2.3",
    "@jankrajewskiit/configs": "^3.7.10",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "^8.3.4",
    "dependency-cruiser": "^18.6.0",
    "jscpd": "~5.4.1"
  },
  "packageManager": "npm@12.2.0",
  "overrides": {
    "eslint": "$eslint"
  }
}
