{
  "name": "@jankrajewskiit/demo",
  "version": "3.3.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetdemo.git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --force",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@jankrajewskiit/auth": "^3.4.1",
    "@jankrajewskiit/i18n": "^3.4.1",
    "@jankrajewskiit/ui": "^3.4.3",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@jankrajewskiit/configs": "^3.4.2",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  }
}
