{
  "name": "@jankrajewskiit/demo",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetdemo.git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --force",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@jankrajewskiit/auth": "^2.0.7",
    "@jankrajewskiit/data": "^0.2.8",
    "@jankrajewskiit/reactive": "^2.0.8",
    "@jankrajewskiit/ui": "^3.1.3",
    "@solidjs/router": "^1.0.0",
    "lightweight-charts": "^5.2.1",
    "oidc-client-ts": "^3.5.0",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.15",
    "solid-markdown": "^2.1.1"
  },
  "devDependencies": {
    "@jankrajewskiit/configs": "^2.0.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14"
  }
}
